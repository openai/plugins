{
  "name": "datascience-mcp-widgets",
  "version": "0.2.8",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run build:chart && npm run build:table && npm run build:artifact && npm run build:portable-reader && npm run normalize:assets",
    "build:artifact": "cross-env INPUT=datascience-artifact-widget.html vite build",
    "build:chart": "cross-env INPUT=datascience-chart-widget.html vite build",
    "build:table": "cross-env INPUT=datascience-table-widget.html vite build",
    "build:portable-reader": "cross-env INPUT=portable-artifact-reader.html vite build",
    "dev": "concurrently \"npm:dev:chart\" \"npm:dev:table\" \"npm:dev:artifact\"",
    "dev:artifact": "cross-env INPUT=datascience-artifact-widget.html vite build --watch",
    "dev:chart": "cross-env INPUT=datascience-chart-widget.html vite build --watch",
    "dev:portable-reader": "cross-env INPUT=portable-artifact-reader.html vite build --watch",
    "dev:table": "cross-env INPUT=datascience-table-widget.html vite build --watch",
    "preview:widgets": "vite --host 127.0.0.1",
    "normalize:assets": "node scripts/normalize-widget-assets.mjs",
    "report:deliver": "node skills/build-report/scripts/deliver_portable_artifact.mjs",
    "report:verify": "node skills/build-report/scripts/verify_portable_artifact.mjs",
    "test": "node --test tests/*.test.mjs src/analytics-app/*.test.mjs",
    "test:portable-browser": "node tests/portable-browser.smoke.mjs",
    "test:portable-conversions": "cross-env OAIPKG_DISABLE_META_MISSING=1 PYTHONPATH=skills/build-report/report-to-google-doc/scripts python3 -m unittest discover -s skills/build-report/report-to-google-doc/scripts/tests -p test_portable_fallback.py && node --test tests/report-to-google-slides-portable.test.mjs",
    "test:portable-parity": "node tests/portable-parity.smoke.mjs",
    "test:portable-release": "node tests/portable-release-package.smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lexical/history": "^0.44.0",
    "@lexical/link": "^0.44.0",
    "@lexical/list": "^0.44.0",
    "@lexical/markdown": "^0.44.0",
    "@lexical/react": "^0.44.0",
    "@lexical/rich-text": "^0.44.0",
    "@modelcontextprotocol/ext-apps": "^1.7.0",
    "html-to-image": "1.11.13",
    "lexical": "^0.44.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.61.1",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
